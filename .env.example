# ──────────────────────────────────────────────────────────────────────────────
# Rumble MCP — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# Required: Firebase ID token obtained from the Rumble mobile/web app.
# Extract it from the app's network traffic (Authorization: Bearer <token>).
# Expires after 1 hour; pair with RUMBLE_REFRESH_TOKEN for auto-renewal.
RUMBLE_FIREBASE_TOKEN=

# Optional but recommended: Firebase refresh token for automatic token renewal.
# When set, the client will silently refresh the ID token before it expires.
# Extract alongside RUMBLE_FIREBASE_TOKEN from the app's network traffic.
RUMBLE_REFRESH_TOKEN=

# Optional: Default market code used for all list/track-record requests.
# Supported values: EGY (Egypt), USA, etc.
# Defaults to EGY when not set.
RUMBLE_MARKET=EGY

# Optional: Stable device ID sent in x-rumble-device-id request headers.
# When not set, a cryptographically random ID is generated each startup.
# Set this to a fixed value to mimic a consistent client device.
RUMBLE_DEVICE_ID=

# Optional: Stable session ID sent in x-rumble-session-id request headers.
# When not set, a cryptographically random ID is generated each startup.
RUMBLE_SESSION_ID=
