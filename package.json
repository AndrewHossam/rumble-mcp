{
  "name": "rumble-mcp",
  "version": "2.2.0",
  "description": "MCP server for TheRumble.app investment research data",
  "main": "dist/index.js",
  "bin": {
    "rumble-mcp": "dist/index.js"
  },
  "type": "module",
  "keywords": [
    "mcp",
    "rumble",
    "investment",
    "egypt",
    "egx",
    "stocks"
  ],
  "author": "Andrew Hossam <me@andrewhossam.com> (https://andrewhossam.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewHossam/rumble-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/AndrewHossam/rumble-mcp/issues"
  },
  "homepage": "https://github.com/AndrewHossam/rumble-mcp#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "extract-token": "tsx src/extract-token.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "tsx src/test-integration.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "audit:ci": "npm audit --audit-level=high --omit=dev",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run audit:ci",
    "prepare": "husky",
    "prepublishOnly": "npm run validate && npm run build"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.3.1",
    "zod": "^3.25.28",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.7.4",
    "semantic-release": "^25.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  }
}
